---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['pipe-logo', className]}>
  <span class="pipe-ink">RedLine</span>
  <svg class="pipe-bar" viewBox="0 0 24 40" aria-hidden="true">
    <path
      d="M 12 2 C 9 13 15 27 12 38"
      fill="none"
      stroke="var(--red, #e0342c)"
      stroke-width="6.5"
      stroke-linecap="round"
    />
  </svg>
  <span class="pipe-ink">Spec</span>
</span>
